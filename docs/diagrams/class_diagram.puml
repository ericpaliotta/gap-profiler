below is the UML class diagram for the whole project
None of the attributes or methods are included here because it would make the diagram
less readable (and is redundant given we have autogenerated docs). Instead just the class
names and their relationships to other package-defined classes are shown. Note that there
are some PyQt classes shown here to make the inheritance structure clear, but these inheritances
only are shown to one layer deep. To see deeper Qt relationships (i.e. what QWidget inherits
from), see the PyQt5 documentation
 '/

@startuml

' all non-project defined classes below
package PyQt5 {
    class "QMainWindow"
    class "QWidget"
    class "QTreeView"
    class "QStandardItemModel"
    class "QSortFilterProxyModel"
    class "QStyledItemDelegate"
}

package QsciScintilla {
    class "QsciScintilla"
    class "QSciLexerCustom"
}

' data processing
package data_processing {
    class "Parser"
    class "Scope"
    class "FunctionCall"
}

' data types
package data_types {
    class "CodeLookup"
    class "CallGraph"
    enum "WidgetType" /' not actually an enum, but an imitation of one using class attributes '/
    class "DataRoles"
    class "OrderBy"
}

' visualization
package visualization {
    class "MainWindow"
    class "QSciLexerGAP"
    class "MultiFilterModel"
    class "Editor"
    class "EditorBody"
    class "CallGraphWrapperWidget"
    abstract class "AbstractCallGraphWidget"
    class "CallTree"
    class "CallList"
    class "CallGraphVisualizationDelegate"
    class "CallTreeElement"
    class "CallListChild"
    class "CallListParent"
}

' defines inheritance scheme
QMainWindow <|-- MainWindow

QWidget <|-- Editor
QWidget <|-- CallGraphWrapperWidget
QWidget <|-- AbstractCallGraphWidget
QWidget <|-- CallTree
QWidget <|-- CallList
QWidget <|-- CallTreeElement
QWidget <|-- CallListParent
QWidget <|-- CallListChild

QStyledItemDelegate <|-- CallGraphVisualizationDelegate

QSortFilterProxyModel <|-- MultiFilterModel

QsciScintilla <|-- EditorBody
QSciLexerCustom <|-- QSciLexerGAP

AbstractCallGraphWidget <|-- CallTree
AbstractCallGraphWidget <|-- CallList

' defines relationships for data processing
Parser *-- Scope
Parser *-- CodeLookup
Parser *-- CallGraph

' defines relationships for GUI
MainWindow *-- Editor
MainWindow *-- CallGraphWrapperWidget

Editor *-- CodeLookup
Editor *-- EditorBody
EditorBody *-- QSciLexerGAP

CallGraphWrapperWidget *-- CodeLookup
CallGraphWrapperWidget *-- CallGraph
CallGraphWrapperWidget *-- CallTree
CallGraphWrapperWidget *-- CallList

AbstractCallGraphWidget *-- CallGraph
AbstractCallGraphWidget *-- QStandardItemModel
AbstractCallGraphWidget *-- QTreeView
AbstractCallGraphWidget *-- MultiFilterModel
AbstractCallGraphWidget *-- CallGraphVisualizationDelegate

@enduml